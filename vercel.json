{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(about|team|mentors|program|faq|apply|statistics|hiring|records)/?",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "api/chat.ts": {
      "maxDuration": 30
    },
    "api/status.ts": {
      "maxDuration": 30
    }
  }
}

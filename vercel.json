{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/apply/?",
      "status": 307,
      "headers": {
        "Location": "https://forms.fillout.com/t/oqB8WMKbJ6us"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/demo/boundaries/?",
      "dest": "/demo/boundaries/index.html"
    },
    {
      "src": "/(about|team|mentors|program|faq|statistics|hiring|records|partnerships|sponsors|confirmation|thank-you)/?",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "api/chat.ts": {
      "maxDuration": 30
    },
    "api/status.ts": {
      "maxDuration": 30
    }
  }
}

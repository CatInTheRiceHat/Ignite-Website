# -------------------------------------------------------
# Ignite — Environment Variables
# Copy this file to .env.local for local development.
# Add these to your Vercel project settings for production.
# -------------------------------------------------------

# Supabase — https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# (Optional) Once you verify a sending domain in Resend, set this.
# Until then, leave it unset — the API will fall back to onboarding@resend.dev.
# RESEND_FROM_EMAIL=noreply@yourdomain.com

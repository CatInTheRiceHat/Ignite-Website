{{!
    @template local_ignite/fuse_home
    The month's fuse at the top of a learner's Home, shown inside the dashboard template. Example context (json):
    {"xp":40,"goal":100,"award":20,"marks":"16,50,100","drops":"2,3,5","key":"7-202612","balance":2,
     "eyebrow":"December Heat · ends in 5 days 2 hours","title":"Your fuse is burning.","sub":"60 XP to the big bomb.",
     "summary":"40 of 100 XP burned this month","legend":"The mini bombs drop 2 and 3 Embers; the big bomb drops 5.",
     "streak":"1-week streak","streaknote":"Earn XP by Sunday to keep it","embers":"2 Embers","shopurl":"#",
     "cup":"The Forgelings finished 2nd in November’s Campfire Cup: +50 Embers for you.",
     "boom1":"Boom! Your December badge is now Bronze. +2 Embers banked.",
     "boom2":"Boom! Your December badge is now Silver. +3 Embers banked.",
     "boom3":"Boom! Gold December badge and +5 Embers banked.",
     "primary":{"url":"#","name":"Loops and lists quiz"},"catalogurl":"#"}
}}
<section class="fuse-home" aria-labelledby="fuse-title" data-xp="{{xp}}" data-goal="{{goal}}" data-award="{{award}}"
    data-marks="{{marks}}" data-drops="{{drops}}" data-key="{{key}}" data-boom1="{{boom1}}" data-boom2="{{boom2}}" data-boom3="{{boom3}}">
    <div class="fuse-home__head">
        <div>
            <p class="fuse-home__eyebrow">{{eyebrow}}</p>
            <h2 id="fuse-title">{{title}}</h2>
            <p class="fuse-home__sub">{{sub}}</p>
        </div>
        <ul class="fuse-home__chips">
            <li class="fuse-chip">
                <svg viewBox="0 0 24 24" fill="none" stroke="#ffd36b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="3"/><path d="M4 10h16M9 3v4M15 3v4M9 15l2 2 4-4"/></svg>
                <strong>{{streak}}</strong>
                <span>{{streaknote}}</span>
            </li>
            <li>
                <a class="fuse-chip" href="{{shopurl}}">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#ff8a2a" d="M12 2c1 4 6 6 6 12a6 6 0 0 1-12 0c0-3 1.5-4.5 2-7 1.5 1 2 2.5 2 4 1.5-2 2-5 2-9Z"/><path fill="#ffd36b" d="M12 12c.7 2 3 3 3 5.5a3 3 0 0 1-6 0c0-1.5.8-2.3 1-3.5.8.5 1 1.2 1 2 .7-1 1-2.5 1-4Z"/></svg>
                    <strong>{{embers}}</strong>
                    <span>{{#str}}fuse_spend, local_ignite{{/str}}</span>
                </a>
            </li>
        </ul>
    </div>

    <div class="fuse">
        <svg class="fuse__svg" role="img" aria-labelledby="fuse-summary"></svg>
        <p id="fuse-summary" class="fuse__summary">{{summary}}</p>
        <p class="fuse__toast" role="status"></p>
    </div>

    <div class="fuse-home__foot">
        {{#primary}}
            <a class="fuse-home__go" href="{{url}}">{{#str}}dash_continue, local_ignite{{/str}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a>
            <p class="fuse-home__next">{{#enrol}}{{#str}}enroloptions, local_ignite{{/str}}: {{/enrol}}{{^enrol}}{{#str}}dash_upnext, local_ignite{{/str}}: {{/enrol}}{{name}}</p>
        {{/primary}}
        {{^primary}}
            <a class="fuse-home__go" href="{{catalogurl}}">{{#str}}explorecourses, local_ignite{{/str}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a>
        {{/primary}}
    </div>
    {{#cup}}<p class="fuse-home__cup">{{cup}}</p>{{/cup}}
    <p class="fuse-home__legend">{{legend}}</p>
</section>

        <section class="ignite-dashboard__section ignite-dashboard__hearth-card">
            <h3>{{#str}}dash_myhearth, local_ignite{{/str}}</h3>
            {{#hearth}}
                <div class="ignite-dashboard__identity">
                    {{#mascoturl}}<img src="{{mascoturl}}" alt="" width="88" height="88">{{/mascoturl}}
                    {{#placeholder}}<span>{{#str}}mascotpending, local_ignite{{/str}}</span>{{/placeholder}}
                    <div><h4>{{name}}</h4><p>{{personality}}</p></div>
                </div>
                <p>{{description}}</p>
                {{#inactive}}<p>{{#str}}inactivehouse, local_ignite{{/str}}</p>{{/inactive}}
                {{#challenge}}
                    <h4>{{name}}</h4><p>{{description}}</p>{{#available}}<p>{{progress}}</p>
                    <progress value="{{value}}" max="{{target}}" aria-label="{{progress}}">{{progress}}</progress>
                    <p><strong>{{own}}</strong></p>{{/available}}{{^available}}<p>{{#str}}totals_pending, local_ignite{{/str}}</p>{{/available}}
                    <p class="ignite-dashboard__small">{{#str}}totalsdelay, local_ignite{{/str}} {{#asof}}{{#str}}totalsasof, local_ignite{{/str}} {{asof}}{{/asof}}</p>
                {{/challenge}}
                {{^challenge}}<p>{{#str}}nochallenge, local_ignite{{/str}}</p>{{/challenge}}
                <a href="{{hearthurl}}">{{#str}}dash_openhearth, local_ignite{{/str}}<span class="ignite-dashboard__arrow" aria-hidden="true"></span></a>
            {{/hearth}}
            {{^hearth}}
                <p>{{#str}}nohouse, local_ignite{{/str}}</p>
                {{#offer}}<p class="ignite-dashboard__notice">{{#str}}dash_invitation, local_ignite{{/str}}</p><p><a href="{{invitationurl}}">{{#str}}dash_meethearths, local_ignite{{/str}}</a></p>{{/offer}}
                {{^offer}}{{#deferred}}<p>{{#str}}dash_deferred, local_ignite{{/str}}</p>{{/deferred}}<p><a href="{{chooseurl}}">{{#str}}choosehearth, local_ignite{{/str}}</a></p>{{/offer}}
                <p class="ignite-dashboard__small">{{#str}}houseaccess, local_ignite{{/str}}</p>
            {{/hearth}}
        </section>

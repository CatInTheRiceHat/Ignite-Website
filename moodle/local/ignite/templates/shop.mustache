{{!
    @template local_ignite/shop
    The Shop: a learner's saved Embers and the prizes they can be cashed in for. Example context (json):
    {"balance":12,"saved":"Embers saved","tiers":[{"name":"Kindling","price":5,"saved":5,"pricelabel":"5 Embers each",
     "progresslabel":"Embers saved towards Kindling","status":"You have enough for one of these!",
     "prizes":[{"name":"Fired Up Button Pin","description":"A glossy cream button of Sol.","photo":"#"}]}]}
}}
<svg width="0" height="0" style="position: absolute" aria-hidden="true">
    <symbol id="ignite-ember" viewBox="0 0 24 24">
        <path fill="#f07b2a" d="M12 2c1 4 6 6 6 12a6 6 0 0 1-12 0c0-3 1.5-4.5 2-7 1.5 1 2 2.5 2 4 1.5-2 2-5 2-9Z"/>
        <path fill="#ffd36b" d="M12 12c.7 2 3 3 3 5.5a3 3 0 0 1-6 0c0-1.5.8-2.3 1-3.5.8.5 1 1.2 1 2 .7-1 1-2.5 1-4Z"/>
    </symbol>
</svg>
<div class="ignite-shop">
    <div class="ignite-shop__inner">
        <header class="ignite-shop__head">
            <div>
                <h1>{{#str}}shop, local_ignite{{/str}}</h1>
                <p class="ignite-shop__lead">{{#str}}shop_lead, local_ignite{{/str}}</p>
            </div>
            <p class="ignite-shop__balance">
                <strong><svg class="ignite-shop__ember" aria-hidden="true"><use href="#ignite-ember"/></svg>{{balance}}</strong>
                {{saved}}
            </p>
        </header>
        {{#tiers}}
        <section class="ignite-shop__tier">
            <header class="ignite-shop__tier-head">
                <h2>{{name}}</h2>
                <p class="ignite-shop__price"><svg class="ignite-shop__ember" aria-hidden="true"><use href="#ignite-ember"/></svg>{{pricelabel}}</p>
                <p class="ignite-shop__togo"><progress max="{{price}}" value="{{saved}}" aria-label="{{progresslabel}}"></progress>{{status}}</p>
            </header>
            <ul class="ignite-shop__prizes">
                {{#prizes}}
                <li class="ignite-shop__prize">
                    <img class="ignite-shop__photo" src="{{photo}}" alt="" width="800" height="800" loading="lazy">
                    <div class="ignite-shop__body"><h3>{{name}}</h3><p>{{description}}</p></div>
                </li>
                {{/prizes}}
            </ul>
        </section>
        {{/tiers}}
    </div>
</div>

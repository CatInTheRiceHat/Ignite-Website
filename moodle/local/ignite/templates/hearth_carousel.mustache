<div class="hearth-carousel" role="region" aria-label="{{#str}}browsehearths, local_ignite{{/str}}">
    <div class="hearth-carousel__viewport" tabindex="0" role="group" aria-label="{{#str}}browsehearths, local_ignite{{/str}}">
        {{#slides}}
        <article class="hearth-slide hearth-slide--{{team}}" aria-labelledby="hearth-preview-{{team}}"
                data-previous="{{#str}}previoushearthnamed, local_ignite, {{name}}{{/str}}"
                data-next="{{#str}}nexthearthnamed, local_ignite, {{name}}{{/str}}">
            <div class="hearth-slide__content">
                <div class="hearth-slide__top-border">
                    <img class="hearth-slide__crest hearth-slide__crest--top" src="{{topcrest}}" alt="">
                    <img class="hearth-slide__medal" src="{{medal}}" alt="" width="384" height="384">
                </div>
                <img class="hearth-slide__illustration" src="{{art}}" alt="" width="640" height="357"
                     srcset="{{art}} 640w, {{artlarge}} 1920w" sizes="(max-width: 600px) calc(91vw - 5rem), min(90vw, 120svh, 70rem)">
                <img class="hearth-slide__crest hearth-slide__crest--bottom" src="{{bottomcrest}}" alt="">
                <div class="hearth-slide__description">
                    <h3 id="hearth-preview-{{team}}">{{name}}</h3>
                    <p>{{description}}</p>
                </div>
                <form method="post" action="{{action}}">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="firstjoin" value="1">
                    <button type="submit" class="hearth-slide__join" name="hearthid" value="{{id}}">{{#str}}joinhearthpreview, local_ignite, {{name}}{{/str}}</button>
                </form>
            </div>
        </article>
        {{/slides}}
    </div>
    <div class="hearth-carousel__controls" hidden>
        <button type="button" data-step="-1" data-default="{{#str}}previoushearth, local_ignite{{/str}}">
            <span aria-hidden="true">←</span> <span class="hearth-carousel__label sr-only visually-hidden"></span>
        </button>
        <button type="button" data-step="1" data-default="{{#str}}nexthearth, local_ignite{{/str}}">
            <span aria-hidden="true">→</span> <span class="hearth-carousel__label sr-only visually-hidden"></span>
        </button>
    </div>
    <span class="sr-only visually-hidden" role="status"></span>
</div>

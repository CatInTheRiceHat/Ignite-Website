<section id="campfire-standings" aria-labelledby="campfire-board-title">
    <div class="campfire-month">
        <div class="campfire-heading">
            <h2 id="campfire-board-title">{{#str}}monthlystandings, local_ignite{{/str}}</h2>
            <h3>{{month}}</h3>
            {{#archives}}<nav aria-label="{{#str}}standingsmonths, local_ignite{{/str}}">
                {{#previousurl}}<a rel="prev" href="{{.}}">{{#str}}previousmonth, local_ignite{{/str}}</a>{{/previousurl}}
                {{#nexturl}}<a rel="next" href="{{.}}">{{#str}}nextmonth, local_ignite{{/str}}</a>{{/nexturl}}
            </nav>{{/archives}}
        </div>
        {{#cupart}}<span class="campfire-cup-art" aria-hidden="true"><img src="{{.}}" alt="" width="104" height="106"></span>{{/cupart}}
    </div>
    {{#reviewneeded}}<p>{{#str}}cupunderreview, local_ignite{{/str}}</p>{{/reviewneeded}}
    {{#awaitingclose}}<p>{{#str}}cupawaiting, local_ignite{{/str}}</p>{{/awaitingclose}}
    <ol class="campfire-ranks">
        {{#rows}}<li class="campfire-team{{#trophy}} campfire-team--winner{{/trophy}}" value="{{rank}}">
            <img src="{{art}}" alt="" width="640" height="357">
            <span class="campfire-rank">{{#str}}teamrank, local_ignite, {{rank}}{{/str}}</span>
            <div class="campfire-score">
                <h4>{{name}}</h4>
                {{#representing}}<p class="campfire-supporting">{{#str}}yourcampfire, local_ignite{{/str}}</p>{{/representing}}
                <strong>{{#str}}teamxptotal, local_ignite, {{total}}{{/str}}</strong>
                <p>{{#str}}yourteamxp, local_ignite, {{own}}{{/str}}</p>
                {{#representing}}<a class="campfire-learn" href="{{learnurl}}">{{#str}}learnforteam, local_ignite{{/str}}</a>{{/representing}}
                {{#trophy}}<strong class="campfire-cup-ribbon"><span aria-hidden="true">🏆</span> {{.}}</strong>{{/trophy}}
            </div>
        </li>{{/rows}}
    </ol>
    {{#empty}}<p>{{#closed}}{{#str}}nochampion, local_ignite{{/str}}{{/closed}}{{^closed}}{{#str}}noteamxpyet, local_ignite{{/str}}{{/closed}}</p>{{/empty}}
    {{#chooseurl}}<p><a href="{{.}}">{{#str}}choosecampfire, local_ignite{{/str}}</a></p>{{/chooseurl}}
</section>
{{#live}}
{{#js}}
const deadline = Date.now() + {{rolloverseconds}} * 1000;
function nextCampfireMonth() {
    const remaining = deadline - Date.now();
    if (remaining <= 0) {
        window.location.reload();
    } else {
        window.setTimeout(nextCampfireMonth, Math.min(remaining, 2147483647));
    }
}
nextCampfireMonth();
{{/js}}
{{/live}}

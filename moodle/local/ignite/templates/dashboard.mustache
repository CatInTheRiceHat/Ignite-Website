{{! A single current-user projection, shared by the native block and optional Ignite home. }}
<div class="ignite-dashboard">
    <section class="ignite-dashboard__welcome" aria-label="{{welcome}}">
        <div>
            <p class="ignite-dashboard__eyebrow">{{#str}}dash_yourspace, local_ignite{{/str}}</p>
            <h2>{{welcome}}</h2>
            <p>{{#str}}dash_welcomecopy, local_ignite{{/str}}</p>
            {{#primary}}
                <p><a class="ignite-dashboard__primary" href="{{url}}">{{#str}}dash_continue, local_ignite{{/str}}<span class="ignite-dashboard__arrow" aria-hidden="true"></span></a></p>
                <p class="ignite-dashboard__next">{{#enrol}}{{#str}}enroloptions, local_ignite{{/str}}: {{/enrol}}{{^enrol}}{{#str}}dash_upnext, local_ignite{{/str}}: {{/enrol}}<strong>{{name}}</strong></p>
            {{/primary}}
            {{^primary}}<p>{{#str}}dash_noprimary, local_ignite{{/str}}</p><p><a href="{{catalogurl}}">{{#str}}explorecourses, local_ignite{{/str}}</a></p>{{/primary}}
        </div>
        <img src="{{solurl}}" alt="" width="144" height="144">
    </section>

    {{#selectionunavailable}}<p class="ignite-dashboard__notice">{{#str}}dash_selectionunavailable, local_ignite{{/str}}</p>{{/selectionunavailable}}
    {{#resumeonboarding}}<p><a href="{{onboardingurl}}">{{#str}}dash_resume, local_ignite{{/str}}</a></p>{{/resumeonboarding}}

    {{#timeline}}<section class="ignite-dashboard__section ignite-dashboard__timeline" aria-label="{{timelinetitle}}">
        <h3>{{timelinetitle}}</h3>{{{timeline}}}
    </section>{{/timeline}}

    {{#onboarding}}<nav class="ignite-dashboard__help" aria-label="{{#str}}dash_help, local_ignite{{/str}}"><a href="{{interestsurl}}">{{#str}}editinterests, local_ignite{{/str}}</a><a href="{{toururl}}">{{#str}}dash_help, local_ignite{{/str}}</a></nav>{{/onboarding}}
</div>

<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/ignite/db" VERSION="20261105" COMMENT="Ignite learner services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="local_ignite_prefs" COMMENT="Private learner preferences; independent of enrollment">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="interests" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="goals" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="notstarted" SEQUENCE="false"/>
        <FIELD NAME="currentstep" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="interests" SEQUENCE="false"/>
        <FIELD NAME="pathid" TYPE="char" LENGTH="64" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="targetkey" TYPE="char" LENGTH="64" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="user" TYPE="foreign-unique" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_ignite_house" COMMENT="Administrator managed houses; IDs and codes remain stable">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="code" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="accent" TYPE="char" LENGTH="7" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="emblem" TYPE="char" LENGTH="30" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="active" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="shortname" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="personality" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="mascot" TYPE="char" LENGTH="30" NOTNULL="true" DEFAULT="placeholder" SEQUENCE="false"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="code" UNIQUE="true" FIELDS="code"/></INDEXES>
    </TABLE>
    <TABLE NAME="local_ignite_member" COMMENT="One current house per user; no course or cohort associations">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="houseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="user" TYPE="foreign-unique" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="house" TYPE="foreign" FIELDS="houseid" REFTABLE="local_ignite_house" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_ignite_history" COMMENT="Membership intervals; conservative second boundaries">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" NOTNULL="true" SEQUENCE="true" LENGTH="10"/>
        <FIELD NAME="userid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10"/>
        <FIELD NAME="houseid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10"/>
        <FIELD NAME="timebegin" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10"/>
        <FIELD NAME="timeend" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="house" TYPE="foreign" FIELDS="houseid" REFTABLE="local_ignite_house" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userperiod" FIELDS="userid, timebegin, timeend" UNIQUE="false"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_ignite_challenge" COMMENT="One immutable period shared equally by every Hearth">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" NOTNULL="true" SEQUENCE="true" LENGTH="10"/>
        <FIELD NAME="name" TYPE="char" NOTNULL="true" SEQUENCE="false" LENGTH="100"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="target" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10"/>
        <FIELD NAME="timestart" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10"/>
        <FIELD NAME="timeend" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10"/>
        <FIELD NAME="timezone" TYPE="char" NOTNULL="true" SEQUENCE="false" LENGTH="100"/>
        <FIELD NAME="active" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="1"/>
        <FIELD NAME="timecreated" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_ignite_milestone" COMMENT="Designated native activity and completion condition">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" NOTNULL="true" SEQUENCE="true" LENGTH="10"/>
        <FIELD NAME="challengeid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10"/>
        <FIELD NAME="cmid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10"/>
        <FIELD NAME="conditiontype" TYPE="char" NOTNULL="true" SEQUENCE="false" LENGTH="20"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="challenge" TYPE="foreign" FIELDS="challengeid" REFTABLE="local_ignite_challenge" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="activity" FIELDS="challengeid, cmid" UNIQUE="true"/>
        <INDEX NAME="cm" FIELDS="cmid" UNIQUE="false"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_ignite_credit" COMMENT="First qualification ledger; withdrawn and excluded rows prevent repeats">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" NOTNULL="true" SEQUENCE="true" LENGTH="10"/>
        <FIELD NAME="challengeid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10"/>
        <FIELD NAME="userid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10"/>
        <FIELD NAME="cmid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10"/>
        <FIELD NAME="houseid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0"/>
        <FIELD NAME="timequalified" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10"/>
        <FIELD NAME="status" TYPE="char" NOTNULL="true" SEQUENCE="false" LENGTH="20"/>
        <FIELD NAME="timemodified" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="challenge" TYPE="foreign" FIELDS="challengeid" REFTABLE="local_ignite_challenge" REFFIELDS="id"/>
        <KEY NAME="user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="once" FIELDS="challengeid, userid, cmid" UNIQUE="true"/>
        <INDEX NAME="own" FIELDS="userid, houseid, challengeid, status" UNIQUE="false"/>
        <INDEX NAME="shared" FIELDS="challengeid, houseid, status" UNIQUE="false"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_ignite_total" COMMENT="Task computed shared totals; no learner roster">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" NOTNULL="true" SEQUENCE="true" LENGTH="10"/>
        <FIELD NAME="challengeid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10"/>
        <FIELD NAME="houseid" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10"/>
        <FIELD NAME="milestones" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10" DEFAULT="0"/>
        <FIELD NAME="timeupdated" TYPE="int" NOTNULL="true" SEQUENCE="false" LENGTH="10"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="challenge" TYPE="foreign" FIELDS="challengeid" REFTABLE="local_ignite_challenge" REFFIELDS="id"/>
        <KEY NAME="house" TYPE="foreign" FIELDS="houseid" REFTABLE="local_ignite_house" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="total" FIELDS="challengeid, houseid" UNIQUE="true"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_ignite_invite" COMMENT="Own Hearth invitation; separate from walkthrough and membership">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="state" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="pending" SEQUENCE="false"/>
        <FIELD NAME="startercmid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timeshown" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="user" TYPE="foreign-unique" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_ignite_feature" COMMENT="Private Passport choices referencing native award instances; no credential data">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="badgeid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="issuedid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="slot" TYPE="int" LENGTH="1" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userslot" UNIQUE="true" FIELDS="userid, slot"/>
        <INDEX NAME="userbadge" UNIQUE="true" FIELDS="userid, badgeid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>

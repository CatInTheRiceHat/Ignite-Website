{
  "name": "temp-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "moodle:check": "node scripts/sync-moodle.mjs",
    "moodle:deploy": "node scripts/sync-moodle.mjs --apply",
    "moodle:dashboard:check": "node scripts/sync-moodle.mjs --dashboard",
    "moodle:dashboard:install": "node scripts/sync-moodle.mjs --dashboard --apply",
    "prebuild": "tsx scripts/index-sol-site.ts",
    "dev": "tsx --env-file-if-exists=.env.local scripts/dev-sol.ts",
    "build": "tsc -b && npm run typecheck:sol && vite build && npm run build:sol",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:sol": "vite build --config config/vite.sol.config.ts",
    "typecheck:sol": "tsc --project config/tsconfig.sol-server.json && tsc --project config/tsconfig.sol-tools.json",
    "test": "vitest run --config config/vitest.sol.config.ts",
    "test:browser": "playwright test --config config/playwright.sol.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "@types/nodemailer": "^8.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.11",
    "lucide-react": "^0.454.0",
    "nodemailer": "^8.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "react-router-dom": "^7.14.0",
    "resend": "^6.10.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "postcss": "^8.4.47",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^6.4.4",
    "tsx": "^4.20.0",
    "vitest": "^5.0.3",
    "@playwright/test": "^1.56.0",
    "@axe-core/playwright": "^4.11.0"
  },
  "engines": {
    "node": "22.x"
  }
}
